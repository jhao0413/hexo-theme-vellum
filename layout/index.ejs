<%
  const posts = site.posts.sort('date', -1);
  const recent = posts.limit(theme.home.recent || 8);
  const essays = vellum_essays();
  const first = posts.length ? posts.data[posts.length - 1].date : null;
  const days = first ? Math.max(1, Math.round((Date.now() - first.valueOf()) / 86400000)) : 0;
  const decor = ['print', 'pixel'].includes(theme.home.decor) ? theme.home.decor : null;
%>
<section class="hero<%= decor ? ' hero-' + decor : '' %>">
  <% if (decor) { %><%- partial('_partial/decor-' + decor, { postCount: posts.length }) %><% } %>

  <div class="wrap narrow hero-inner<%= decor ? ' decor-' + decor : '' %>">
    <% if (decor === 'print') { %><span class="crop crop-tl" aria-hidden="true"></span><span class="crop crop-tr" aria-hidden="true"></span><span class="crop crop-bl" aria-hidden="true"></span><span class="crop crop-br" aria-hidden="true"></span><% } %>
    <% if (theme.avatar) { %>
      <div class="hero-avatar reveal">
        <img src="<%- url_for(theme.avatar) %>" alt="<%= config.author %>" width="96" height="96">
      </div>
    <% } %>
    <h1 class="hero-title reveal" style="--i: 1"><%= theme.home.greeting %> <span class="accent"><%= config.author %></span></h1>
    <% if (theme.home.bio) { %><p class="hero-bio reveal" style="--i: 2"><%= theme.home.bio %></p><% } %>
    <% if (theme.home.quote_from_essays && essays.length) { %>
      <blockquote class="hero-quote reveal" style="--i: 3">
        <p>「<%= essays[0].content %>」</p>
      </blockquote>
    <% } %>
    <p class="hero-stats reveal" style="--i: 4">
      <span><b><%= posts.length %></b> <%= __('posts') %></span>
      <span aria-hidden="true">·</span>
      <span><b><%= vellum_format_k(vellum_total_words()) %></b> <%= __('words') %></span>
      <span aria-hidden="true">·</span>
      <span><b><%= days %></b> <%= __('days') %></span>
    </p>
    <% if (Object.values(theme.social || {}).some(Boolean)) { %>
      <p class="hero-social reveal" style="--i: 5">
        <% for (const name in theme.social) { const url = theme.social[name]; if (!url) continue; %>
          <a class="icon-button" href="<%- name === 'email' ? 'mailto:' + url : url %>" aria-label="<%= name[0].toUpperCase() + name.slice(1) %>" <% if (name !== 'email') { %>target="_blank" rel="noopener"<% } %>><%- vellum_icon(name) %></a>
        <% } %>
      </p>
    <% } %>
  </div>
</section>

<div class="wrap narrow">

  <section class="section">
    <h2 class="section-title reveal"><%= __('recent_writing') %></h2>
    <ol class="post-index">
      <% recent.each(function (post, i) { %>
        <li class="reveal" style="--i: <%= i %>">
          <a href="<%- url_for(post.path) %>">
            <span class="post-index-num"><%= vellum_pad(i + 1) %></span>
            <span class="post-index-title"><%= post.title %></span>
            <span class="post-index-meta">
              <% if (post.categories.length) { %><span><%= post.categories.data[0].name %></span><% } %>
              <time datetime="<%= date_xml(post.date) %>"><%= date(post.date, 'YYYY-MM-DD') %></time>
            </span>
          </a>
        </li>
      <% }) %>
    </ol>
    <a class="more-link" href="<%- url_for(config.archive_dir + '/') %>"><%= __('all_posts') %> <%- vellum_icon('arrow') %></a>
  </section>

  <% if (essays.length && theme.home.essays) { %>
    <section class="section">
      <h2 class="section-title reveal"><%= __('recent_essays') %></h2>
      <ul class="essay-list compact">
        <% essays.slice(0, theme.home.essays).forEach(function (e, i) { %>
          <li class="reveal" style="--i: <%= i %>">
            <% if (e.date) { %><time><%= date(e.date, 'YYYY-MM-DD') %></time><% } %>
            <p><%= e.content %></p>
          </li>
        <% }) %>
      </ul>
      <a class="more-link" href="<%- url_for('/essays/') %>"><%= __('all_essays') %> <%- vellum_icon('arrow') %></a>
    </section>
  <% } %>
</div>
