<%# Printer's proof sheet: baseline grid, registration marks, color bar and slug line. Crop marks live in index.ejs. %>
<div class="hero-decor decor-print-bg" aria-hidden="true">
  <div class="baseline-grid"></div>
  <svg class="reg-mark reg-left" viewBox="0 0 28 28"><circle cx="14" cy="14" r="7"/><path d="M14 0v28M0 14h28"/></svg>
  <svg class="reg-mark reg-right" viewBox="0 0 28 28"><circle cx="14" cy="14" r="7"/><path d="M14 0v28M0 14h28"/></svg>
  <div class="color-bar"><i></i><i></i><i></i><i></i><i></i><i></i></div>
  <p class="slug"><%= config.title %> &nbsp;/&nbsp; PROOF Nº <%= postCount %> &nbsp;/&nbsp; <%= date(new Date(), 'YYYY.MM.DD') %></p>
</div>
