<dialog class="search-dialog" aria-label="<%= __('search') %>" data-src="<%- url_for((config.search && config.search.path) || 'search.json') %>">
  <div class="search-box">
    <div class="search-field">
      <%- vellum_icon('search') %>
      <input type="search" role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="search-results"
        placeholder="<%= __('search_placeholder') %>" autocomplete="off" spellcheck="false" enterkeyhint="search"
        aria-label="<%= __('search') %>" autofocus>
      <button class="icon-button search-close" type="button" aria-label="<%= __('search_close') %>">
        <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18"/></svg>
      </button>
    </div>
    <p class="search-status" role="status" data-hint="<%= __('search_hint') %>" data-empty="<%= __('search_empty') %>"
      data-loading="<%= __('search_loading') %>" data-error="<%= __('search_error') %>"><%= __('search_hint') %></p>
    <ul id="search-results" class="search-results" role="listbox" aria-label="<%= __('search') %>" hidden></ul>
  </div>
</dialog>
