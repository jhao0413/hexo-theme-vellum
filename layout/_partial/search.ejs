<dialog class="search-dialog" aria-label="<%= __('search') %>" data-src="<%- url_for((config.search && config.search.path) || 'search.json') %>">
  <div class="search-box">
    <div class="search-field">
      <%- vellum_icon('search') %>
      <input type="search" placeholder="<%= __('search_placeholder') %>" autocomplete="off" spellcheck="false" aria-label="<%= __('search') %>">
      <kbd class="kbd">Esc</kbd>
    </div>
    <ul class="search-results" role="listbox" data-empty="<%= __('search_empty') %>" data-hint="<%= __('search_hint') %>"></ul>
  </div>
</dialog>
