<% const g = theme.comment && theme.comment.gitalk; %>
<% if (theme.comment && theme.comment.enable && page.comments !== false && g && g.clientID && g.clientSecret && g.repo && g.owner) { %>
  <section class="comments" id="comments"
    data-gitalk='<%- JSON.stringify({
      clientID: g.clientID,
      clientSecret: g.clientSecret,
      repo: g.repo,
      owner: g.owner,
      admin: [g.owner],
      language: config.language,
      proxy: g.proxy || 'https://github.com/login/oauth/access_token'
    }).replace(/'/g, '&#39;') %>'>
    <div id="gitalk-container"></div>
  </section>
<% } %>
